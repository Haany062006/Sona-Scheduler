# Sona Scheduler - Environment Configuration

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Credentials (PostgreSQL Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Notification Providers
# Options for SMS: console (default for testing), fast2sms, twilio
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=SONASCH
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Options for Email: console (default for testing), resend, sendgrid, smtp
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=remedial@sonatech.ac.in
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Designated Institutional Remedial CC contacts (comma-separated emails)
REMEDIAL_CC_EMAILS=hod.ads@sonatech.ac.in,hod.it@sonatech.ac.in
